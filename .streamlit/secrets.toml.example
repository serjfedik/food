# Скопируй в .streamlit/secrets.toml (НЕ коммить!) или вставь в Streamlit Cloud
# → Settings → Secrets

# Google service account JSON (вариант 1 — рекомендуется для Streamlit Cloud).
# Создаётся в Google Cloud Console: IAM → Service Accounts → Keys → Add Key (JSON).
# Не забудь поделиться целевой папкой Google Drive с email сервисного аккаунта.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# ID папки в Google Drive, где будут храниться рецепты (из URL папки).
[google_drive]
folder_id = "your-google-drive-folder-id"

# Anthropic API ключ для Vision (распознавание продуктов с фото холодильника).
# Получить: https://console.anthropic.com → API Keys.
# Опционально: без ключа вкладка «фото холодильника (ai)» покажет инструкцию.
ANTHROPIC_API_KEY = "sk-ant-..."
