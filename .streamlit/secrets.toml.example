# Скопируй в .streamlit/secrets.toml (НЕ коммить!) или вставь в Streamlit Cloud
# → Settings → Secrets

# Google service account JSON (вариант 1 — рекомендуется для Streamlit Cloud).
# Создаётся в Google Cloud Console: IAM → Service Accounts → Keys → Add Key (JSON).
# Не забудь поделиться целевой папкой Google Drive с email сервисного аккаунта.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# ID папки в Google Drive, где будут храниться рецепты (из URL папки).
[google_drive]
folder_id = "your-google-drive-folder-id"

# (Опционально) ID мастер-таблицы Google Sheets — вторичная база знаний.
# При сохранении рецепта/дневника/холодильника в неё пишется ровная таблица
# на отдельных вкладках («Рецепты», «Дневник», «Холодильник»). Если оставить
# пустым или не задавать секцию — Sheets-синк выключен, остальное работает.
[google_sheets]
spreadsheet_id = "your-spreadsheet-id"

# ───────────────────────────────────────────────────────────────────────────
# Vision / AI-OCR — нужен ДЛЯ ОДНОГО ИЗ:
#   - «AI-OCR» в Редакторе (распознавание рукописных рецептов; Tesseract
#     с такими сканами не справляется в принципе),
#   - вкладки «фото холодильника (ai)» в Холодильнике.
#
# Достаточно ОДНОГО из трёх ключей. Приоритет автодетекта:
# OpenAI → Gemini → Anthropic.
# ───────────────────────────────────────────────────────────────────────────

# Рекомендуется (то же качество, что в ChatGPT; знакомая регистрация):
# https://platform.openai.com/api-keys, минимум $5 на счёт.
OPENAI_API_KEY = "sk-..."

# Бесплатно, free tier 1500 запросов/день; без карты:
# https://aistudio.google.com → Get API Key
GEMINI_API_KEY = "AIza..."

# Альтернатива OpenAI: https://console.anthropic.com → API Keys, минимум $5.
ANTHROPIC_API_KEY = "sk-ant-..."
